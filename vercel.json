{
  "buildCommand": "npm run export",
  "outputDirectory": "web-build",
  "devCommand": "npx expo start --web",
  "framework": "expo",
  "projectSettings": {
    "buildCommand": "npm run export",
    "outputDirectory": "web-build",
    "installCommand": "npm ci"
  },
  "env": {
    "EXPO_PUBLIC_GEMINI_API_KEY": "@gemini_api_key",
    "EXPO_PUBLIC_API_URL": "@api_url"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}